APP_NAME=ArdhiLens
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_VM_IP_OR_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Docker: DB_HOST is overridden to "mysql" by docker-compose
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ardhilens
DB_USERNAME=ardhilens
DB_PASSWORD=ardhilens_secret_change_me
DB_ROOT_PASSWORD=root_secret_change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@ardhilens.tz"
MAIL_FROM_NAME="${APP_NAME}"

GEMINI_API_KEY=
GEMINI_RETRIES=1
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TEMPERATURE=0.1
GEMINI_ENABLE_CONTRADICTION_CHECK=true

NOTIFICATION_IN_APP=true
NOTIFICATION_EMAIL=true
NOTIFICATION_PUSH=false
NOTIFICATION_SMS=false
NOTIFICATION_FCM_SERVER_KEY=

CERTIFICATE_VALIDITY_MONTHS=12

# Host port exposed by Docker (default 80)
APP_PORT=80
