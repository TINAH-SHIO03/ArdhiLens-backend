[Unit]
Description=ArdhiLens Backend (Docker Compose)
Documentation=https://github.com/TINAH-SHIO03/ArdhiLens-backend
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ardhilens/ArdhiLens-backend
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
